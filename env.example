# Copy to .env (never commit the real file). Variable names only; no real values.

# Postgres password used by docker-compose.example.yml to build DATABASE_URL.
POSTGRES_PASSWORD=
# When running without compose, set the URL directly:
# DATABASE_URL=postgres://user:password@localhost:5432/whisper_hub

# Bearer token for the /admin routes and the key CLI, at least 32 characters.
HUB_ADMIN_TOKEN=
# Owner id a new device key gets when the mint names none.
# HUB_OWNER_ID=rico   (the default; migration 0002 backfills existing rows to it)
LOG_LEVEL=info

# OpenAI-compatible inference host (llama-swap or similar) for speech-to-text,
# voice synthesis, and the LLM relay.
VOICE_UPSTREAM_URL=http://localhost:8080
VOICE_UPSTREAM_API_KEY=
VOICE_STT_MODEL=whisper-large-v3-turbo
# VOICE_PROFILE_DIR=/voice

# Unset: the LLM relay reuses VOICE_UPSTREAM_URL and its key.
LLM_UPSTREAM_URL=
LLM_UPSTREAM_API_KEY=
# Comma-separated model ids; empty allows all.
LLM_MODEL_ALLOWLIST=
